# Store large microscopy images with Git LFS
*.ome.tif filter=lfs diff=lfs merge=lfs -text
*.ome.tiff filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
# Treat QuPath and Office binary data as binary
*.qpdata binary
*.docx binary
# Normalize text files
*.md text eol=lf
*.groovy text eol=lf
*.geojson filter=lfs diff=lfs merge=lfs -text
*.qpproj text eol=lf
